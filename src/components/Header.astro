---
import Menu from '../assets/icons/menu.svg';
---

<header class="bg-blue-700 dark:bg-blue-700 high-contrast:bg-black high-contrast:border-b-2 high-contrast:border-white text-white p-4 shadow-md transition-colors duration-300 motion-reduce:transition-none">
  <div class="container mx-auto flex flex-wrap gap-3 justify-between items-center pl-4 pr-4">
    <div class="flex items-center">
      <div class="relative group">
        <button id="menu-toggle" class="inline-flex min-h-11 min-w-11 items-center justify-center focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-500 high-contrast:focus:ring-yellow-300 high-contrast:focus:ring-offset-black rounded mr-2 sm:mr-4" aria-label="Toggle menu" aria-expanded="false" aria-controls="menu" data-testid="menu-toggle">
          <Menu class="h-6 w-6" aria-hidden="true" />
        </button>
        <nav id="menu" aria-label="Main" class="hidden absolute left-0 mt-2 w-48 bg-white dark:bg-slate-800 high-contrast:bg-black high-contrast:border high-contrast:border-white text-slate-800 dark:text-white rounded shadow-lg z-10 transition-colors duration-300 motion-reduce:transition-none">
          <ul class="py-1">
            <li><a href="/" class="block min-h-11 px-4 py-3 hover:bg-slate-100 dark:hover:bg-slate-700 high-contrast:hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 high-contrast:focus:ring-yellow-300" data-testid="nav-home">Home</a></li>
            <li><a href="/about" class="block min-h-11 px-4 py-3 hover:bg-slate-100 dark:hover:bg-slate-700 high-contrast:hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 high-contrast:focus:ring-yellow-300" data-testid="nav-about">About</a></li>
          </ul>
        </nav>
      </div>
      <div class="text-xl font-bold"><a href="/" class="hover:underline focus:outline-none focus:ring-2 focus:ring-white rounded high-contrast:focus:ring-yellow-300" data-testid="nav-brand">Tailspin Toys</a></div>
    </div>
    <button
      type="button"
      class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-white/70 px-3 py-2 text-sm font-medium hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-500 high-contrast:border-yellow-300 high-contrast:bg-yellow-300 high-contrast:text-black high-contrast:hover:bg-yellow-200 high-contrast:focus:ring-yellow-300 high-contrast:focus:ring-offset-black"
      id="contrast-toggle"
      aria-label="Enable high contrast mode"
      aria-pressed="false"
      data-testid="contrast-toggle"
    >
      <span aria-hidden="true">◐</span>
      <span>High contrast</span>
      <span data-testid="contrast-state">Off</span>
    </button>
  </div>
</header>

<script>
  // Toggle menu visibility when hamburger is clicked
  const menuToggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu');
  
  if (menuToggle && menu) {
    menuToggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      const isExpanded = !menu.classList.contains('hidden');
      menuToggle.setAttribute('aria-expanded', String(isExpanded));
      if (isExpanded) {
        const firstLink = menu.querySelector('a');
        if (firstLink) firstLink.focus();
      }
    });
    
    // Close menu when clicking outside
    document.addEventListener('click', (event) => {
      const target = event.target;
      const isClickInside = target instanceof Node && (menuToggle.contains(target) || menu.contains(target));
      if (!isClickInside && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
      }
    });

    // Close menu with Escape key and return focus to toggle button
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.focus();
      }
    });
  }

  const contrastToggle = document.querySelector<HTMLButtonElement>('[data-testid="contrast-toggle"]');
  const contrastState = document.querySelector<HTMLElement>('[data-testid="contrast-state"]');
  const contrastStorageKey = 'tailspin-high-contrast';

  if (contrastToggle && contrastState) {
    const setHighContrast = (enabled: boolean): void => {
      document.documentElement.classList.toggle('high-contrast', enabled);
      contrastToggle.setAttribute('aria-pressed', String(enabled));
      contrastToggle.setAttribute(
        'aria-label',
        enabled ? 'Disable high contrast mode' : 'Enable high contrast mode',
      );
      contrastState.textContent = enabled ? 'On' : 'Off';

      try {
        localStorage.setItem(contrastStorageKey, String(enabled));
      } catch {
        // Storage can be unavailable in privacy-restricted browsers.
      }
    };

    setHighContrast(document.documentElement.classList.contains('high-contrast'));
    contrastToggle.addEventListener('click', () => {
      setHighContrast(contrastToggle.getAttribute('aria-pressed') !== 'true');
    });
  }
</script>
