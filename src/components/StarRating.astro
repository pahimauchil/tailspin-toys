---
import { clampRating, formatStarRating } from '../lib/ratings';

interface Props {
    rating: number | null;
}

const { rating } = Astro.props;
---

{rating !== null && (
    <div class="flex items-center">
        <span class="bg-blue-500/20 high-contrast:bg-black high-contrast:border high-contrast:border-white text-blue-400 high-contrast:text-white text-sm px-3 py-1 rounded-full" data-testid="game-rating">
            <span class="text-yellow-400 high-contrast:text-yellow-300">{formatStarRating(rating)}</span>
            {clampRating(rating).toFixed(1)}
        </span>
    </div>
)}
